{
  "name": "lamsa-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/lib/api/schema.d.ts",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/reem-kufi": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.104.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
